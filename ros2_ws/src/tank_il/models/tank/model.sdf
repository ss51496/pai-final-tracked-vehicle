<?xml version="1.0"?>
<!-- gen_tank_model.py で生成。直接編集せず、スクリプトのパラメータを変更すること -->
<sdf version="1.8">
  <model name="tank">
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>300.0</mass>
        <inertia><ixx>29.00000</ixx><iyy>104.00000</iyy><izz>125.00000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry><box><size>2.0 1.0 0.4</size></box></geometry>
      </collision>
      <visual name="hull_visual">
        <geometry><box><size>2.0 1.0 0.4</size></box></geometry>
        <material><ambient>0.3 0.38 0.22 1</ambient><diffuse>0.3 0.38 0.22 1</diffuse></material>
      </visual>
      <!-- 履帯（見た目のみ。衝突判定は車輪が担当） -->
      <visual name="track_left">
        <pose>0 0.570 -0.170 0 0 0</pose>
        <geometry><box><size>2.150 0.160 0.320</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="track_right">
        <pose>0 -0.570 -0.170 0 0 0</pose>
        <geometry><box><size>2.150 0.160 0.320</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/imu</topic>
        <imu>
          <angular_velocity><x><noise type="none"/></x><y><noise type="none"/></y><z><noise type="none"/></z></angular_velocity>
          <linear_acceleration><x><noise type="none"/></x><y><noise type="none"/></y><z><noise type="none"/></z></linear_acceleration>
        </imu>
      </sensor>
    </link>

    <link name="wheel_l0">
      <pose>-0.900 0.570 -0.170 -1.57080 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>5.0</mass>
        <inertia><ixx>0.03629</ixx><iyy>0.03629</iyy><izz>0.05625</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
