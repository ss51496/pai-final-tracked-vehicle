    <link name="turret">
      <pose>0 0 0.290 0 0 0</pose>
      <inertial>
        <pose>0.1700 0 0 0 0 0</pose>
        <mass>75.0</mass>
        <inertia><ixx>2.01150</ixx><iyy>12.78800</iyy><izz>14.46350</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="turret_collision">
        <geometry><cylinder><radius>0.35</radius><length>0.18</length></cylinder></geometry>
      </collision>
      <visual name="turret_visual">
        <geometry><cylinder><radius>0.35</radius><length>0.18</length></cylinder></geometry>
        <material><ambient>0.35 0.43 0.25 1</ambient><diffuse>0.35 0.43 0.25 1</diffuse></material>
      </visual>
      <!-- 砲身: 壁との接触を再現するため衝突判定を付ける -->
      <collision name="barrel_collision">
        <pose>0.850 0 0 0 1.57080 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>1.3</length></cylinder></geometry>
      </collision>
      <!-- 砲身が壁などに接触したかを検出する（評価の指標に使う） -->
      <sensor name="barrel_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <contact><collision>barrel_collision</collision></contact>
      </sensor>
      <visual name="barrel_visual">
        <pose>0.850 0 0 0 1.57080 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>1.3</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="turret_joint" type="revolute">
      <parent>base_link</parent>
      <child>turret</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.1416</lower><upper>3.1416</upper></limit>
        <dynamics><damping>5</damping></dynamics>
      </axis>
    </joint>

    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
    <left_joint>wheel_l0_joint</left_joint>
    <left_joint>wheel_l1_joint</left_joint>
    <left_joint>wheel_l2_joint</left_joint>
    <left_joint>wheel_l3_joint</left_joint>
    <left_joint>wheel_l4_joint</left_joint>
    <left_joint>wheel_l5_joint</left_joint>
    <left_joint>wheel_l6_joint</left_joint>
    <right_joint>wheel_r0_joint</right_joint>
    <right_joint>wheel_r1_joint</right_joint>
    <right_joint>wheel_r2_joint</right_joint>
    <right_joint>wheel_r3_joint</right_joint>
    <right_joint>wheel_r4_joint</right_joint>
    <right_joint>wheel_r5_joint</right_joint>
    <right_joint>wheel_r6_joint</right_joint>
      <wheel_separation>1.140</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tank_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>turret_joint</joint_name>
      <topic>/tank/turret_cmd</topic>
      <p_gain>500</p_gain>
      <i_gain>0</i_gain>
      <d_gain>100</d_gain>
      <cmd_max>2000</cmd_max>
      <cmd_min>-2000</cmd_min>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>turret_joint</joint_name>
    </plugin>
    <!-- 真値の位置姿勢（world 座標、z を含む 3 次元）。DiffDrive の /odom は車輪の積分で滑りを含むため別に出す -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom_gt</odom_topic>
      <tf_topic>/odom_gt_tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
