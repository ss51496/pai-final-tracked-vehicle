        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_l0_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_l0</child>
