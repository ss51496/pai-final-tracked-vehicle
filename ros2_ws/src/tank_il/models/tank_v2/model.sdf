<?xml version="1.0"?>
<!-- gen_tank_model.py で生成。直接編集せず、スクリプトのパラメータを変更すること -->
<sdf version="1.8">
  <model name="tank">
    <link name="base_link">
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>28500.0</mass>
        <inertia><ixx>18430.00000</ixx><iyy>132430.00000</iyy><izz>146110.00000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="hull_collision">
        <geometry><box><size>7.4 2.6 1.0</size></box></geometry>
      </collision>
      <visual name="hull_visual">
        <geometry><box><size>7.4 2.6 1.0</size></box></geometry>
        <material><ambient>0.3 0.38 0.22 1</ambient><diffuse>0.3 0.38 0.22 1</diffuse></material>
      </visual>
      <!-- 履帯（見た目のみ。衝突判定は車輪が担当） -->
      <visual name="track_left">
        <pose>0 1.310 -0.500 0 0 0</pose>
        <geometry><box><size>5.200 0.640 0.920</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <visual name="track_right">
        <pose>0 -1.310 -0.500 0 0 0</pose>
        <geometry><box><size>5.200 0.640 0.920</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <!-- 車体が壁などに接触（激突）したかを検出する（砲身の接触センサーとは別） -->
      <sensor name="hull_contact" type="contact">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <contact><collision>hull_collision</collision></contact>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <topic>/imu</topic>
        <imu>
          <angular_velocity><x><noise type="none"/></x><y><noise type="none"/></y><z><noise type="none"/></z></angular_velocity>
          <linear_acceleration><x><noise type="none"/></x><y><noise type="none"/></y><z><noise type="none"/></z></linear_acceleration>
        </imu>
      </sensor>
    </link>

    <link name="wheel_l0">
      <pose>-2.125 1.310 -0.500 -1.57080 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>400.0</mass>
        <inertia><ixx>33.06333</ixx><iyy>33.06333</iyy><izz>40.50000</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.45</radius><length>0.62</length></cylinder></geometry>
        <surface><friction><ode>
